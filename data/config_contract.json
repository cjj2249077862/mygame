{
  "version": 1,
  "schemas": {
    "cards": {"main": "s:id,name_key,description_key,role,owner,target,rarity;b:reward,exhaust,retain;n:cost", "effects": "s:id,card_id,kind,status,target,parameter;b:upgraded;n:order,amount,hits,threat_mult"},
    "characters": {"main": "s:id,name_key,role,passive,portrait;n:max_hp,strength,passive_amount", "starter": "s:id,character_id,card_id;n:count"},
    "encounters": {"main": "s:id,name_key,enemies;n:order,gold", "enemies": "s:id,name_key;n:max_hp,strength,interrupt_threshold,immunity_count", "intents": "s:id,enemy_id,kind,status;n:order,amount,hits,stacks"},
    "battle_rules": {"main": "s:id;n:value", "statuses": "s:id,name_key;b:dispellable;n:per_stack,decay"},
    "texts_zh_cn": {"main": "s:id,text"}
  },
  "roles": ["tank", "assassin", "healer"],
  "effects": ["damage", "heal", "shield", "interrupt", "dispel"],
  "passives": ["first_damage", "first_heal", "first_shield"],
  "statuses": ["poison", "burn", "regen", "weak", "vulnerable"],
  "initial_lineup": ["warden", "blade", "mender"],
  "rules": {
    "party_size": {"min": 3, "max": 3, "integer": true},
    "base_energy": {"min": 1, "integer": true},
    "draw_count": {"min": 1, "integer": true},
    "hand_limit": {"min": 1, "integer": true},
    "initial_tank_threat": {"min": 0, "integer": true},
    "initial_other_threat": {"min": 0, "integer": true},
    "heal_threat": {"min": 0},
    "post_battle_revive": {"min": 0, "exclusive_min": true, "max": 1},
    "reward_count": {"min": 1, "integer": true},
    "weak_multiplier": {"min": 0, "max": 1},
    "vulnerable_multiplier": {"min": 1},
    "starting_gold": {"min": 0, "integer": true}
  },
  "starter_cards": {
    "slash": {"role": "tank", "owner": "", "target": "enemy", "effects": [{"kind": "damage", "hits": 1}]},
    "guard": {"role": "tank", "owner": "", "target": "self", "effects": [{"kind": "shield", "hits": 1}]},
    "stab": {"role": "assassin", "owner": "", "target": "enemy", "effects": [{"kind": "damage", "hits": 1}]},
    "parry": {"role": "assassin", "owner": "", "target": "self", "effects": [{"kind": "shield", "hits": 1}]},
    "smite": {"role": "healer", "owner": "", "target": "enemy", "effects": [{"kind": "damage", "hits": 1}]},
    "heal": {"role": "healer", "owner": "", "target": "ally", "effects": [{"kind": "heal", "hits": 1}]},
    "shield_bash": {"role": "", "owner": "warden", "target": "enemy", "effects": [{"kind": "damage", "hits": 1}, {"kind": "interrupt", "hits": 1}]},
    "double_stab": {"role": "", "owner": "blade", "target": "enemy", "effects": [{"kind": "damage", "hits": 2}]},
    "first_aid": {"role": "", "owner": "mender", "target": "ally", "effects": [{"kind": "heal", "hits": 1}, {"kind": "dispel", "hits": 1}]}
  },
  "fixed_upgrade_fields": ["kind", "hits", "status", "target", "parameter", "threat_mult"],
  "required_texts": {
    "ui.title": [], "ui.subtitle": [], "ui.start": [], "ui.restart": [],
    "ui.end_turn": [], "ui.cast": [], "ui.cancel": [], "ui.skip": [],
    "ui.reward": [], "ui.win": [], "ui.loss": [], "ui.loading": [],
    "ui.select_card": [], "ui.select_caster": [], "ui.select_target": [], "ui.confirm_self": [],
    "ui.confirm_end": [], "ui.confirm": [], "ui.close": [], "ui.piles": [],
    "ui.fast": [], "ui.dispel": [], "ui.dispel_confirm": [], "ui.party": [],
    "ui.enemies": [], "ui.log": [], "ui.reward_hint": [], "ui.result_hint": [],
    "ui.stats": ["energy", "gold", "turn"],
    "ui.unit": ["hp", "max_hp", "name", "shield", "threat"],
    "ui.card": ["cost", "description", "name"],
    "ui.intent": ["amount", "hits", "immunity", "kind", "stacks", "status", "target"],
    "ui.immune": [], "ui.not_immune": [], "ui.interrupted": [], "ui.dead": [],
    "ui.preview": ["hp_delta", "name", "shield_delta", "threat_delta"],
    "ui.preview_cost": ["cost", "energy"], "ui.preview_dispel": ["status"],
    "ui.pile.draw": [], "ui.pile.hand": [], "ui.pile.discard": [],
    "ui.pile.exhaust": [], "ui.pile.removed": [], "ui.pile.deck": [],
    "ui.kind.normal": [], "ui.kind.interruptible": [], "ui.kind.uninterruptible": [],
    "error.phase": [], "error.card": [], "error.energy": [], "error.caster": [],
    "error.target": [], "error.dispel": [], "error.config": [],
    "log.start": ["turn"],
    "log.damage": ["amount", "source", "target"],
    "log.heal": ["amount", "source", "target"],
    "log.shield": ["amount", "source", "target"],
    "log.interrupt": ["target"], "log.interrupt_failed": ["target"],
    "log.dispel": ["status", "target"], "log.status": ["amount", "status", "target"],
    "log.death": ["target"], "log.ot": ["target"], "log.win": [], "log.loss": [],
    "ui.health": [], "ui.status_effect": [],
    "keyword.retain": [], "keyword.exhaust": [], "keyword.interrupt": [],
    "status_desc.poison": ["per_stack", "decay"],
    "status_desc.burn": ["per_stack", "decay"],
    "status_desc.regen": ["per_stack", "decay"],
    "status_desc.weak": ["percent", "decay"],
    "status_desc.vulnerable": ["percent", "decay"]
  }
}
