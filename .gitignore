# Godot 缓存和 CSV 导入生成的翻译文件
/.godot/
/.import/
*.translation

# 构建与导出产物，export_presets.cfg 随项目提交
/build/
/exports/
/*.pck

# C# / .NET 本地构建产物
/.mono/
/bin/
/obj/
mono_crash.*.json

# 编辑器设置和系统临时文件
/.vscode/
/.idea/
/.vs/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# Python 导表缓存及表格生成器检查产物
__pycache__/
*.pyc
*.xlsx.inspect.ndjson

# 文档与美术预览不参与 Godot 资源导入
/mywork/**/*.import
